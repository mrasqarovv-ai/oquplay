NODE_ENV=development
PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgresql://oquplay:local_only@localhost:5432/oquplay
WEB_ORIGIN=http://localhost:8081
# api.key is never required for demo. "live" must be explicitly selected.
LLM_MODE=demo
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_MS=45000
LLM_MAX_OUTPUT_TOKENS=12000
GENERATION_DAILY_LIMIT=10
GENERATION_GLOBAL_DAILY_LIMIT=100
# Native requests must connect through HTTPS in production.
# Static Expo web export is served by API when set, with same-origin cookies.
STATIC_WEB_DIR=
