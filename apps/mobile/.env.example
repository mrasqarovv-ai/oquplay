# Android physical phone / iPhone: use your computer's LAN IPv4, e.g. http://192.168.1.10:3001
# Android emulator: http://10.0.2.2:3001. Web in development: http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
# Shareable Expo web URL. On physical phones replace localhost with LAN IP.
EXPO_PUBLIC_WEB_URL=http://localhost:8081
